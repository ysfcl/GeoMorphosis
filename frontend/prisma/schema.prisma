generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model periodic_subscriptions {
  id                  Int               @id @default(autoincrement())
  region_id           Int?
  notification_target String?
  unsubscribe_token   String?           @unique
  interval_minutes    Int?              @default(120)
  last_checked_at     DateTime?         @default(now())
  is_active           Boolean?          @default(true)
  regions_analysis    regions_analysis? @relation(fields: [region_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model regions_analysis {
  id                     Int                      @id @default(autoincrement())
  ip_address             String?
  user_id                String?                  @unique            
  telegram_chat_id       String?                  
  image_no               String?
  timestamp              DateTime?                @default(now())
  region_name            String?
  coordinates            String?
  ai_results             String?
  periodic_subscriptions periodic_subscriptions[]
}

// Bildirim kanallari (Faz 1): e-posta aboneligi + dogrulama durumu.
// Telegram eslestirmesi hala regions_analysis.telegram_chat_id uzerinden
// yurutulur; bu tablo kanal bazli kayit/dogrulama icin tek adres.
model notification_channels {
  id                Int       @id @default(autoincrement())
  user_id           String
  channel           String // 'email' | 'telegram'
  destination       String // e-posta adresi veya Telegram chat_id
  is_active         Boolean   @default(true)
  verification_code String?
  verified_at       DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@unique([user_id, channel])
}
