# GeoMorphosis - Frontend Ortam Degiskenleri
# Ekip arkadaşları için not: Bu dosyayı kopyalayıp adını '.env' yapın.

# Backend (AI Engine) URL
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# Copernicus Data Space API
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here

# NASA FIRMS API Key
NASA_FIRMS_API_KEY=your_firms_api_key_here

# Notification Service (src/lib/email.js)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=false
EMAIL_FROM=your_email@gmail.com
# /api/notify/email GET test endpointinin kullandigi adres
TEST_EMAIL_TO=your_email@gmail.com

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# BotFather'daki bot kullanici adi (@ olmadan). Arayuzdeki baglan butonu bunu kullanir.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
# Canli HTTPS alan adiniz. Telegram raporundaki panel baglantisi bu adrese gider.
NEXT_PUBLIC_APP_URL=https://app.example.com
# setWebhook cagrisiyla ayni deger verilir; Telegram disindaki POST isteklerini reddeder.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
# Docker dışında worker çalıştırılırsa frontend ile aynı değer kullanılmalıdır.
NOTIFICATION_INTERNAL_SECRET=replace_with_a_second_random_secret

# SQLite yolu, `npm run dev` calisirken frontend/ dizinine gore cozulur.
# Docker'da cwd /app'tir ve ./data:/app/data mount'u ai-engine ile ayni
# dosyayi gosterir.
DATABASE_URL="file:./data/geopulse.db"

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
