# GeoMorphosis - Frontend Ortam Degiskenleri (cPanel Production)

# AI Engine URL (cPanel Python uygulamasi yayinlaninca gercek URL ile degistir)
# Ornek: https://ai.senindomain.com veya https://senindomain.com/ai
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# Worker Service URL
NEXT_PUBLIC_WORKER_URL=http://localhost:3001

# Site URL'leri (kendi domaininle degistir)
NEXTAUTH_URL=https://senindomain.com
NEXT_PUBLIC_APP_URL=https://senindomain.com

# NOT: NEXT_PUBLIC_ ile baslayan degiskenler BUILD sirasinda onemlidir.
# cPanel "Setup Node.js App" -> Environment Variables bolumune girilmelidir.
