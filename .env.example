# GeoMorphosis - Kok dizin ortam degiskenleri
# Bu dosya docker-compose tarafindan okunur.
# Kopyalayin:  cp .env.example .env

# --- Bildirim (worker + frontend) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
# Erken uyari e-postasinin gidecegi adres. Bos birakilirsa SMTP_USER kullanilir.
ALERT_EMAIL_TO=

# --- Telegram Bot (opsiyonel) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Canli ortamda frontend konteynerine de aktarilir.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
NEXT_PUBLIC_APP_URL=https://app.example.com
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
# Uretimde genel HTTPS adresiniz. Verilirse Telegram webhook kullanilir.
# BOS BIRAKILIRSA worker Telegram'i kendisi yoklar (long polling) - genel
# adres, ngrok tuneli vb. gerekmeden hesap eslestirme calisir.
TELEGRAM_WEBHOOK_URL=
# Gelistirmede hesap eslestirmeyi test etmek icin true yapin.
# DIKKAT: Telegram bir bot token'i icin ayni anda tek dinleyiciye izin verir.
# Ekipte birden fazla kisi acarsa hepsi 409 Conflict alir ve hicbiri calismaz.
# Kimin acacagina karar verin; digerleri bu satiri false biraksin.
TELEGRAM_POLLING=false
# Worker ile frontend arasındaki dahili e-posta raporu çağrısını doğrular.
NOTIFICATION_INTERNAL_SECRET=replace_with_a_second_random_secret

# --- Yapay zeka modeli ---
# Bos birakilirsa su sira ile aranir:
#   ai-engine/models/fire_yolov8_v2.pt
#   ai-engine/models/fire_yolov8.pt
#   ai-engine/yolov8n.pt
# Hicbiri bulunamazsa sistem demo moduna duser (cokmez).
MODEL_PATH=ai-engine/models/best.pt
# Nesne tespiti icin guven esigi
YOLO_CONF_THRESHOLD=0.10

# --- Worker ---
# Uydu goruntusu indirme + YOLO tahmini icin ust sinir (milisaniye)
ANALYSIS_TIMEOUT_MS=180000

# --- Google Earth Engine ---
# Servis hesabi anahtar dosyasi ai-engine/ altina konur ve .gitignore'dadir.
GOOGLE_EARTH_ENGINE_PROJECT=geomorphosis-cb3ae273c071
